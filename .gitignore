# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
dist/

# Local env files
.env
*.local

# Supabase CLI local artifacts (link/version state)
supabase/.temp/
supabase/.branches/
supabase/supabase/

# Claude Code linked worktrees — full working copies (plus their node_modules) checked
# out under the repo, with machine-absolute gitdir paths. Local scratch, never sources.
# The rest of .claude/ stays tracked: launch.json is shared, and settings.local.json is
# already covered by the global ignore.
.claude/worktrees/

# PostgreSQL test cluster data and runtime logs (generated by pg_ctl)
supabase/tests/**/.pgdata/
supabase/tests/**/pgctl_start.log
supabase/tests/**/*.log

# Playwright MCP artifacts
.playwright-mcp/
